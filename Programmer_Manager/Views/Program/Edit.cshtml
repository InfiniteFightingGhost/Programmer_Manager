@model Programmer_Manager.ViewModels.Program.ProgramEditViewModel

@{
    ViewData["Title"] = "Edit Program";
}

<h1>Edit Program</h1>

<h4>Program</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ProgrammingLanguage" class="control-label"></label>
                <input asp-for="ProgrammingLanguage" class="form-control" />
                <span asp-validation-for="ProgrammingLanguage" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Version" class="control-label"></label>
                <input asp-for="Version" class="form-control" />
                <span asp-validation-for="Version" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ProgrammerId" class="control-label">
                    Programmer
                </label>

                <select asp-for="ProgrammerId"
                        asp-items="ViewBag.Programmers"
                        class="form-control">
                </select>

                <span asp-validation-for="ProgrammerId"
                      class="text-danger">
                </span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
