@model Programmer_Manager.ViewModels.Programmer.ProgrammerCreateViewModel

<h1>Add programmer</h1>

<form asp-action="Create" method="post">

    <label>Name:</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <br />
    <br />

    <label>Address:</label>
    <input asp-for="Address" />
    <span asp-validation-for="Address"></span>

    <br />
    <br />

    <label>Email:</label>
    <input asp-for="Email" />
    <span asp-validation-for="Email"></span>

    <br />
    <br />

    <label>Phone:</label>
    <input asp-for="PhoneNumber" />
    <span asp-validation-for="PhoneNumber"></span>
   
    <br />
    <br />

    <label>Years of experience:</label>
    <input asp-for="YearsOfExperience" />
    <span asp-validation-for="YearsOfExperience"></span>

    <br />
    <br />

    <button type="submit">Save</button>
   
</form>
<a asp-action="Index">Back to list</a>
   

    

<br />

<a href="/Programmer/Index">Show all programmers</a>
